@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Delete Opportunity";
}

<div class="container mt-4">
    <h2>Delete Opportunity</h2>

    <div class="alert alert-warning mt-3">
        Are you sure you want to delete this opportunity?
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <p><strong>Title:</strong> @Model.Title</p>
            <p><strong>Customer:</strong> @Model.CustomerName</p>
            <p><strong>Amount:</strong> ₹@Model.Amount</p>
            <p><strong>Stage:</strong> @Model.Stage</p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>