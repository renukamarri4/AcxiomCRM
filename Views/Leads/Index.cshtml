@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Leads";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Lead Management</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add Lead</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center">No leads found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var lead in Model)
                        {
                            <tr>
                                <td>@lead.Name</td>
                                <td>@lead.Email</td>
                                <td>@lead.Phone</td>
                                <td>@lead.Company</td>
                                <td>@lead.Status</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@lead.Id"
                                       class="btn btn-sm btn-warning">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@lead.Id"
                                       class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>