
@{
    ViewData["Title"] = "User Management";
    var users = ViewBag.Users;
}

<div class="container mt-4">
    <h2>User Management</h2>
    <p class="text-muted">Manage registered users and their roles.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Email</th>
                        <th>Current Role</th>
                        <th>Assign Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@user.Roles</td>
                            <td>
                                <form asp-action="AssignRole" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.UserId" />

                                    <select name="role" class="form-select">
                                        <option value="Admin">Admin</option>
                                        <option value="Manager">Manager</option>
                                        <option value="SalesExecutive">Sales Executive</option>
                                    </select>

                                    <button type="submit" class="btn btn-primary btn-sm">
                                        Update
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
